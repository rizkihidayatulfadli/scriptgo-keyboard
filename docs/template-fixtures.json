[
  {
    "name": "teks biasa tanpa variabel",
    "template": "Halo kak, ada yang bisa dibantu?",
    "expected": { "variables": [], "text": "Halo kak, ada yang bisa dibantu?", "cursor": null }
  },
  {
    "name": "nama diambil dari kontak",
    "template": "Halo {nama}!",
    "contact": { "name": "Budi", "phones": [], "fields": {} },
    "expected": { "variables": [{ "key": "nama" }], "text": "Halo Budi!", "cursor": null }
  },
  {
    "name": "default dipakai jika tidak ada kontak",
    "template": "Halo {nama|Kak}!",
    "expected": { "variables": [{ "key": "nama", "default": "Kak" }], "text": "Halo Kak!", "cursor": null }
  },
  {
    "name": "nilai kontak mengalahkan default",
    "template": "Halo {nama|Kak}!",
    "contact": { "name": "Budi", "phones": [], "fields": {} },
    "expected": { "variables": [{ "key": "nama", "default": "Kak" }], "text": "Halo Budi!", "cursor": null }
  },
  {
    "name": "input user mengalahkan nilai kontak",
    "template": "Halo {nama}!",
    "contact": { "name": "Budi", "phones": [], "fields": {} },
    "inputs": { "nama": "Pak Budi" },
    "expected": { "variables": [{ "key": "nama" }], "text": "Halo Pak Budi!", "cursor": null }
  },
  {
    "name": "nilai kontak kosong jatuh ke default",
    "template": "Diskon {diskon|0}%",
    "contact": { "name": "Budi", "phones": [], "fields": { "diskon": "" } },
    "expected": { "variables": [{ "key": "diskon", "default": "0" }], "text": "Diskon 0%", "cursor": null }
  },
  {
    "name": "key tidak peka huruf besar kecil",
    "template": "Dikirim ke {Kota}",
    "contact": { "name": "Budi", "phones": [], "fields": { "kota": "Bandung" } },
    "expected": { "variables": [{ "key": "kota" }], "text": "Dikirim ke Bandung", "cursor": null }
  },
  {
    "name": "pilihan memakai opsi pertama sebagai default",
    "template": "Kirim via {kurir:JNE, J&T, SiCepat}",
    "expected": {
      "variables": [{ "key": "kurir", "options": ["JNE", "J&T", "SiCepat"] }],
      "text": "Kirim via JNE",
      "cursor": null
    }
  },
  {
    "name": "pilihan diisi dari input user",
    "template": "Kirim via {kurir:JNE,J&T,SiCepat}",
    "inputs": { "kurir": "J&T" },
    "expected": {
      "variables": [{ "key": "kurir", "options": ["JNE", "J&T", "SiCepat"] }],
      "text": "Kirim via J&T",
      "cursor": null
    }
  },
  {
    "name": "koma di-escape di dalam opsi",
    "template": "Ukuran {ukuran:S,M,L\\,XL}",
    "inputs": { "ukuran": "L,XL" },
    "expected": {
      "variables": [{ "key": "ukuran", "options": ["S", "M", "L,XL"] }],
      "text": "Ukuran L,XL",
      "cursor": null
    }
  },
  {
    "name": "key berulang hanya ditanyakan sekali",
    "template": "{nama|Kak}, terima kasih ya {nama}",
    "expected": { "variables": [{ "key": "nama", "default": "Kak" }], "text": "Kak, terima kasih ya Kak", "cursor": null }
  },
  {
    "name": "nomor kontak dalam format nasional",
    "template": "WA: {nomor}",
