{
  "manifest_version": 3,
  "name": "ScriptGo",
  "short_name": "ScriptGo",
  "version": "0.1.0",
  "description": "Ketik /shortcut untuk menyisipkan template pesan, lengkap dengan data kontak. Sinkron dengan aplikasi Android.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScriptGo"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src https://hsanqncbfurjhnshdpnc.supabase.co"
  },
  "permissions": [
    "storage",
    "alarms",
    "identity",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://hsanqncbfurjhnshdpnc.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "form.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "auth.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
